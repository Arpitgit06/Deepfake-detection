# TruthLens AI Environment Configuration
# Copy this file to .env and fill in your values

# App Settings
DEBUG=true
APP_NAME="TruthLens AI"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# Server
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://frontend:5173"]

# Model Paths
MODEL_DIR=./models
PPG_MODEL_PATH=./models/ppg_liveness.onnx
DEEPFAKE_MODEL_PATH=./models/deepfake_detector.onnx
PHONEME_MODEL_PATH=./models/wav2vec2_phoneme
VISEME_MODEL_PATH=./models/viseme_classifier.onnx

# Detection Thresholds
PPG_CONFIDENCE_THRESHOLD=0.75
PHONEME_VISEME_THRESHOLD=0.70
DEEPFAKE_THRESHOLD=0.65
FINANCIAL_THREAT_THRESHOLD=0.60

# LLM (Qwen3-4B-Instruct-2507 Q8_0, downloaded into backend/models/llm by setup.bat)
LLM_ENABLED=true
LLM_MODEL_PATH=./models/llm/Qwen3-4B-Instruct-2507-Q8_0.gguf
LLM_N_GPU_LAYERS=-1
# Refuse CPU/mixed offload and insufficient VRAM instead of silently falling back.
LLM_REQUIRE_GPU=true
# Enable native llama.cpp placement logs for GPU diagnostics.
LLM_VERBOSE=false
LLM_N_CTX=4096
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3
# 0 = unload the model from VRAM immediately after each task
LLM_IDLE_UNLOAD_SECONDS=0

# External API Keys (optional - for threat intelligence)
# Get keys from: https://www.virustotal.com/, https://www.abuseipdb.com/
THREAT_INTEL_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# File Upload Limits
MAX_FILE_SIZE=104857600  # 100MB in bytes

# Logging
LOG_LEVEL=INFO
